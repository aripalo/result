{
	"name": "@aripalo/result",
	"version": "1.1.0",
	"description": "Typesafe error handling (inspired by Go) and data absence protection.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"prepack": "pnpm build"
	},
	"keywords": [
		"error handling",
		"data absence protection"
	],
	"author": {
		"name": "Ari Palo",
		"email": "opensource@aripalo.com",
		"organization": false
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aripalo/result.git"
	},
	"bugs": {
		"url": "https://github.com/aripalo/result/issues"
	},
	"homepage": "https://github.com/aripalo/result#readme",
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^24.13.2",
		"@vitest/coverage-v8": "^4.1.9",
		"semantic-release": "^24.2.0",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
